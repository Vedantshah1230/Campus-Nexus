.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
nbproject/
.buildpath
.project
.settings/

# Composer & Node Dependencies (if added in future)
/vendor/
/node_modules/
dist/
build/
coverage/
